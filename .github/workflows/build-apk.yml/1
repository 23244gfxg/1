name: 生成APK

on:
  workflow_dispatch:
  push:
    branches: [ main, master ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Android SDK
        uses: android-actions/setup-android@v3

      - name: 装 SDK 组件
        run: |
          sdkmanager "platforms;android-34" "build-tools;34.0.0" > /dev/null
          yes | sdkmanager --licenses > /dev/null || true

      - name: 装 Gradle 8.2
        run: |
          wget -q https://services.gradle.org/distributions/gradle-8.2-bin.zip -O /tmp/g.zip
          unzip -q /tmp/g.zip -d /opt
          echo "/opt/gradle-8.2/bin" >> "$GITHUB_PATH"

      - name: 解压工程
        run: |
          if ls *.zip >/dev/null 2>&1; then
            for z in *.zip; do unzip -oq "$z" -x '*/.github/*'; done
          fi
          ROOT=$(dirname "$(find . -name settings.gradle | head -1)")
          echo "工程目录: $ROOT"
          echo "sdk.dir=$ANDROID_HOME" > "$ROOT/local.properties"
          echo "ROOT=$ROOT" >> "$GITHUB_ENV"

      - name: 编译 debug APK
        run: |
          cd "$ROOT"
          gradle assembleDebug --no-daemon --stacktrace
          cp app/build/outputs/apk/debug/app-debug.apk "$GITHUB_WORKSPACE/MiniVRLauncher-debug.apk"

      - name: 上传 APK
        uses: actions/upload-artifact@v4
        with:
          name: MiniVRLauncher-debug
          path: MiniVRLauncher-debug.apk
          if-no-files-found: error
